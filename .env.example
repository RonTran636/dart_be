# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=dart_be
POSTGRES_PASSWORD=dart_be
POSTGRES_DB=dart_be
DB_PORT=5432
API_PORT=8080

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_ISSUER=dart_be
JWT_TTL_MINUTES=60

# Used when running `dart_frog dev` on your machine against the Docker DB:
DATABASE_URL=postgres://dart_be:dart_be@localhost:5432/dart_be?sslmode=disable
